{
	"name": "laravelium/feed",
	"description": "Laravelium Feed package for Laravel.",
	"homepage": "https://github.com/Tpojka/laravel-feed",
	"support": {
		"issues": "https://github.com/Tpojka/laravel-feed/issues"
	},
	"keywords": ["laravelium", "laravel", "feed", "generator", "rss", "atom"],
	"license": "MIT",
	"version": "3.1.3",
	"authors": [
		{
			"name": "Roumen Damianoff",
			"email": "roumen@damianoff.com",
			"role": "Developer",
			"homepage": "https://damianoff.com"
		},
		{
			"name": "Goran Grbic",
			"email": "me@tpojka.com",
			"role": "Maintainer",
			"homepage": "https://www.github.com/Tpojka"
		}
	],
	"require": {
		"php": ">=7.1.3",
		"illuminate/support": "5.7.*|5.8.*"
	},
	"require-dev": {
		"phpunit/phpunit": "~7.0",
		"orchestra/testbench": "3.7.*"
	},
	"autoload": {
		"psr-4": {
			"Laravelium\\Feed\\": "src/Laravelium/Feed/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Laravelium\\Feed\\FeedServiceProvider"
			],
			"aliases": {
        "Feed": "Laravelium\\Feed\\Feed"
      }
		}
	},
	"minimum-stability": "dev",
	"config": {
		"allow-plugins": {
			"kylekatarnls/update-helper": true
		}
	}
}
